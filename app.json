{
  "expo": {
    "name": "Fuel & Form",
    "slug": "fuel-and-form",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fuelandform.app"
    },
    "android": {
      "predictiveBackGestureEnabled": false,
      "package": "com.fuelandform.app"
    },
    "web": {
      "output": "single"
    },
    "scheme": "fuelandform",
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Fuel & Form uses the camera to scan food barcodes.",
          "recordAudioAndroid": false
        }
      ]
    ]
  }
}
